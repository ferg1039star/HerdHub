# Copy to .env.local. Never commit real keys.
# The anon key is a public client key; the service role key and DB URL are NOT
# used by the web app and must never be exposed to the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional public pages required for store listing
VITE_PRIVACY_POLICY_URL=https://your-domain.example/privacy
VITE_SUPPORT_URL=https://your-domain.example/support

# Server-side only — used by scripts/apply-schema.mjs, never bundled into the app.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
